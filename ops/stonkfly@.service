# Optional: keep a paper fly running under systemd (user unit).
#
#   mkdir -p ~/.config/systemd/user
#   cp ops/stonkfly@.service ~/.config/systemd/user/
#   # paths below assume the clone at ~/fly-trader/stonkfly-dashboard
#   systemctl --user daemon-reload
#   systemctl --user enable --now stonkfly@btc
#   loginctl enable-linger "$USER"      # keep running after logout
#
# Per-fly settings go in ~/.config/stonkfly/<name>.env (NOT in git), e.g.
#   FLY_PRODUCT_btc=BTC-USDC
#   FLY_VENUE_s1=orangex-perp    # perpetual paper venue
#   TG_TOKEN=...   TG_CHAT=...          # optional Telegram notices

[Unit]
Description=Stonkfly paper fly %i (flyguard watchdog)
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/fly-trader/stonkfly-dashboard
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/stonkfly/%i.env
# Clock resync: needs util-linux-extra (/usr/sbin/hwclock) + a NOPASSWD sudo rule for the service user; without both, WSL clock skew after suspend/resume is NOT corrected.
ExecStartPre=-/usr/bin/sudo -n /usr/sbin/hwclock -s
ExecStart=%h/fly-trader/stonkfly-dashboard/ops/flyguard.sh %i
Restart=always
RestartSec=30
RestartSteps=5
RestartMaxDelaySec=300
# 75 = flyguard stays down on purpose (STOP file / financial stop / unsettled orders)
RestartPreventExitStatus=75
SuccessExitStatus=75
# SIGINT -> KeyboardInterrupt -> "Stopped; run state preserved."
KillSignal=SIGINT
TimeoutStopSec=180

[Install]
WantedBy=default.target
